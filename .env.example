# ==============================================================================
# DORMEX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# In production (Render Web Service, Vercel Frontend), configure these in 
# the respective hosting platform dashboard.
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT (Backend - Render)
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', 'staging', or 'production' (MANDATORY)
NODE_ENV=development

# Host binding:
# - Local dev: 127.0.0.1
# - Production (Render Web Service): 0.0.0.0 (Accepts Render reverse proxy)
HOST=127.0.0.1

# HTTP port: Render supplies process.env.PORT automatically (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Render Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Mandatory in production. Local development falls back to in-memory db if unset.
# Format: postgresql://[user]:[password]@[endpoint]/[dbname]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dormex

# SSL Mode for PostgreSQL connection: 'true' or 'false'
# Note: Cloud PostgreSQL (Render, AWS RDS) auto-enables SSL.
PG_SSL=false

# Render internal PostgreSQL private network support (dpg-*):
# Render internal hostnames use private certificates; leave unset or false to allow private CA verification.
PG_SSL_REJECT_UNAUTHORIZED=false

# PostgreSQL Connection Pool Settings
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Synthetic Demo Student Data (DEMO-001 through DEMO-030)
# Strictly BLOCKED in production regardless of this flag.
# Set to 'true' in development to seed pilot evaluation students.
SEED_DEMO_DATA=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Backend - Render)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing JWTs and session tokens (MANDATORY IN PRODUCTION)
# Must be at least 32 characters in production. Missing secret halts production startup.
JWT_SECRET=your-minimum-32-character-cryptographic-jwt-secret-here

# Cookie signing secret for session protection
COOKIE_SECRET=your-minimum-32-character-cookie-signing-secret-here

# Production Initial Administrator Bootstrap (Optional)
# If configured during initial migration, creates or updates the default initial super administrator account
# without relying on test passwords.
INITIAL_ADMIN_EMAIL=admin@college.edu
INITIAL_ADMIN_PASSWORD=your-secure-production-admin-password
# Or supply pre-computed scrypt password hash:
# INITIAL_ADMIN_HASH=

# ------------------------------------------------------------------------------
# 4. CORS & WEBAUTHN RELYING PARTY CONFIGURATION (Backend - Render)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS validation in production
CORS_ALLOWED_ORIGINS=https://dormex-sit.vercel.app,https://dormex.vercel.app

# Comma-separated list of additional WebAuthn RP IDs (domains) permitted for hardware credentials
WEBAUTHN_RP_IDS=dormex-sit.vercel.app,dormex.vercel.app

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICE (SMTP) - OPTIONAL
# ------------------------------------------------------------------------------
# When unconfigured, password recovery displays honest institutional office assistance
# fallback instructions without leaking credentials or pretending emails were dispatched.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DORMEX Hostel Office <hostel-office@college.edu>"

# ------------------------------------------------------------------------------
# 6. FRONTEND (Vercel)
# ------------------------------------------------------------------------------
# Note: Frontend communicates via relative path /api/* proxied by vercel.json.
# No sensitive database or authentication secrets should ever be configured in Vercel.
